# ============================================================
# Google Apps Script — Spreadsheet Backend
# ============================================================
# 1. Open your Google Sheet → Extensions → Apps Script
# 2. Paste google-apps-script.js, run setupSheets / seedExercises / seedPrograms
# 3. Deploy → New deployment → Web App (Execute as: Me, Who: Anyone)
# 4. Copy the Web App URL and paste it below
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ============================================================
# Auth — PIN Login
# ============================================================
# Set any numeric PIN or secret string to protect the app
AUTH_SECRET=1234

# ============================================================
# Optional: Cron job secret (for daily notification endpoint)
# ============================================================
# CRON_SECRET=your_cron_secret

# ============================================================
# Optional: Telegram push notifications
# ============================================================
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
