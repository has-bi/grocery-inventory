# ============================================================
# Google Apps Script — Spreadsheet Backend
# ============================================================
# 1. Open your Google Sheet → Extensions → Apps Script
# 2. Paste google-apps-script.js, run setupSheets / seedExercises / seedPrograms
# 3. Deploy → New deployment → Web App (Execute as: Me, Who: Anyone)
# 4. Copy the Web App URL and paste it below
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ============================================================
# Auth — PIN Login
# ============================================================
# Generate both values with:   node scripts/setup-auth.js
# The script prints your PIN once; it is never stored in the project.
#
# AUTH_PIN_HASH  — scrypt hash of the PIN. The PIN itself is never stored.
# SESSION_SECRET — 32+ random bytes used to sign session cookies.
#
# Changing EITHER value signs out every existing session, so rotating the PIN
# also revokes access on a lost device.
AUTH_PIN_HASH=scrypt$16384$8$1$REPLACE_ME$REPLACE_ME
SESSION_SECRET=REPLACE_ME_WITH_32_RANDOM_BYTES

# Deprecated: plaintext PIN. Still honoured so an existing deployment keeps
# working, but it stores your PIN in the clear — migrate to AUTH_PIN_HASH and
# then delete this variable.
# AUTH_SECRET=

# ============================================================
# Optional: Cron job secret (for daily notification endpoint)
# ============================================================
# CRON_SECRET=your_cron_secret

# ============================================================
# Optional: Telegram push notifications
# ============================================================
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
